<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Merges Controls.xaml so the window template can use the IconButton style and the colour brushes
         (Controls.xaml merges Colors.xaml in turn). -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Controls.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <LinearGradientBrush x:Key="WindowSurfaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1C1F25" Offset="0" />
        <GradientStop Color="#141619" Offset="1" />
    </LinearGradientBrush>

    <!-- Custom chrome for dialogs: rounded graphite surface, draggable title bar, close button. -->
    <ControlTemplate x:Key="ChromeWindowTemplate" TargetType="Window">
        <Border Margin="14" CornerRadius="14" Background="{StaticResource WindowSurfaceBrush}"
                BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="3" Direction="270" Opacity="0.5" Color="#000000" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="PART_TitleBar" Background="Transparent">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0">
                        <Viewbox Width="17" Height="17" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="M16.5 7.5h.01 M21 2l-9.6 9.6 M15.5 7.5a6 6 0 1 1-8.49 8.49 6 6 0 0 1 8.49-8.49z M18 5l2 2 M15 8l2.5 2.5"
                                      Stroke="{StaticResource AccentBrush}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="{TemplateBinding Title}" Margin="11,0,0,0" VerticalAlignment="Center"
                                   FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                    </StackPanel>

                    <Button x:Name="PART_Close" Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                            Margin="0,0,10,0" Width="32" Height="32" ToolTip="Close">
                        <Viewbox Width="15" Height="15">
                            <Canvas Width="24" Height="24">
                                <Path Data="M6 6 18 18 M18 6 6 18" Stroke="{StaticResource SecondaryTextBrush}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                </Grid>

                <ContentPresenter Grid.Row="1" />
            </Grid>
        </Border>
    </ControlTemplate>

</ResourceDictionary>
