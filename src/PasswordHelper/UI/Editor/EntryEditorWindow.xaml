<common:ChromeWindow x:Class="PasswordHelper.UI.Editor.EntryEditorWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:common="clr-namespace:PasswordHelper.UI.Common"
                     Title="Add password" Width="460" SizeToContent="Height">
    <StackPanel Margin="24,6,24,22">

        <TextBlock Text="TITLE" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
        <TextBox x:Name="TitleBox" MaxLength="80" TabIndex="0" />

        <TextBlock Text="USERNAME" Style="{StaticResource SectionLabel}" Margin="0,14,0,6" />
        <TextBox x:Name="UsernameBox" MaxLength="200" TabIndex="1" />

        <TextBlock Text="PASSWORD" Style="{StaticResource SectionLabel}" Margin="0,14,0,6" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <PasswordBox x:Name="PasswordBox" TabIndex="2" />
                <TextBox x:Name="PasswordText" Visibility="Collapsed" FontFamily="{StaticResource MonoFontFamily}" />
            </Grid>
            <Button x:Name="RevealButton" Grid.Column="1" Style="{StaticResource IconButton}" Margin="6,0,0,0"
                    ToolTip="Show password" TabIndex="4">
                <Viewbox Width="17" Height="17">
                    <Canvas Width="24" Height="24">
                        <Path x:Name="RevealGlyph" Stroke="{StaticResource SecondaryTextBrush}" StrokeThickness="1.7"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M2.1 12.35a1 1 0 0 1 0-.7 10.75 10.75 0 0 1 19.8 0 1 1 0 0 1 0 .7 10.75 10.75 0 0 1-19.8 0z M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0z" />
                    </Canvas>
                </Viewbox>
            </Button>
            <Button x:Name="GenerateButton" Grid.Column="2" Style="{StaticResource IconButton}" Margin="4,0,0,0"
                    ToolTip="Generate a secure password" TabIndex="5">
                <Viewbox Width="17" Height="17">
                    <Canvas Width="24" Height="24">
                        <Path Stroke="{StaticResource AccentBrush}" StrokeThickness="1.7"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M3 12a9 9 0 0 1 15-6.7L21 8 M21 3v5h-5 M21 12a9 9 0 0 1-15 6.7L3 16 M3 21v-5h5" />
                    </Canvas>
                </Viewbox>
            </Button>
        </Grid>

        <Grid Margin="0,9,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Height="4" CornerRadius="2" Background="{StaticResource InputBrush}" VerticalAlignment="Center">
                <Border x:Name="StrengthBar" HorizontalAlignment="Left" Height="4" CornerRadius="2" Width="0"
                        Background="{StaticResource AccentBrush}" />
            </Border>
            <TextBlock x:Name="StrengthLabel" Grid.Column="1" Margin="10,0,0,0" FontSize="11.5"
                       Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" MinWidth="42"
                       TextAlignment="Right" />
        </Grid>

        <TextBlock Text="WEBSITE (OPTIONAL)" Style="{StaticResource SectionLabel}" Margin="0,16,0,6" />
        <TextBox x:Name="UrlBox" MaxLength="500" TabIndex="3" />

        <TextBlock Text="NOTES (OPTIONAL)" Style="{StaticResource SectionLabel}" Margin="0,16,0,6" />
        <TextBox x:Name="NotesBox" MaxLength="2000" TextWrapping="Wrap" AcceptsReturn="True"
                 MinHeight="62" MaxHeight="120" VerticalScrollBarVisibility="Auto" TabIndex="6"
                 VerticalContentAlignment="Top" />

        <CheckBox x:Name="PinCheck" Content="Show on the main overlay ring" Margin="2,16,0,0" TabIndex="7" />

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="12" TextWrapping="Wrap"
                   Margin="2,14,0,0" Visibility="Collapsed" />

        <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" MinWidth="96" TabIndex="9" />
            <Button x:Name="SaveButton" Grid.Column="2" Content="Save" Style="{StaticResource PrimaryButton}"
                    MinWidth="110" Margin="10,0,0,0" TabIndex="8" IsDefault="True" />
        </Grid>
    </StackPanel>
</common:ChromeWindow>
