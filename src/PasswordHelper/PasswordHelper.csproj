<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>PasswordHelper</RootNamespace>
    <AssemblyName>PasswordHelper</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>

    <Product>Password helper</Product>
    <AssemblyTitle>Password helper</AssemblyTitle>
    <Description>Radial password generator, encrypted password vault and clipboard history for Windows.</Description>
    <Company>Password helper</Company>
    <Copyright>Copyright © 2026</Copyright>
    <Version>1.0.0</Version>

    <!-- Windows 10 1809 is the oldest build whose APIs we rely on (non-destructive ToUnicodeEx, PMv2 DPI). -->
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TieredPGO>true</TieredPGO>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PasswordHelper.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\AppIcon.ico" />
    <!-- Embedded (not copied-to-output) so a single-file publish is truly one .exe with the click sound inside. -->
    <EmbeddedResource Include="Assets\click.mp3">
      <LogicalName>click.mp3</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
